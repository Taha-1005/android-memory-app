{
  "expo": {
    "name": "Mobile Wiki",
    "slug": "mobile-wiki",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/afe979b2-ef55-4732-bb17-6afbe90d0a7c"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mobilewiki",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobilewiki.app"
    },
    "android": {
      "package": "com.mobilewiki.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "afe979b2-ef55-4732-bb17-6afbe90d0a7c"
      }
    },
    "owner": "tahaboy"
  }
}
